rules_version = '2';

// Leaderboard rules. Clients (web today, native iOS later) may read scores and
// append new ones; nobody can edit or delete. Every write is shape-checked here
// because the client can't be trusted.
service cloud.firestore {
  match /databases/{database}/documents {

    // Mirrors scripts/gameLogic.js: 3 rounds × 133 max.
    function maxTotalScore() { return 399; }

    function validCommon(d) {
      return d.name is string
        && d.name.size() >= 1 && d.name.size() <= 24
        && d.score is number
        && d.score >= 0 && d.score <= maxTotalScore()
        && d.url is string
        && d.url.size() <= 200
        && (d.url == '' || d.url.matches('^https?://[^\\s"<>]+$'))
        && d.timestamp == request.time; // must use serverTimestamp()
    }

    // Days since 2025-01-01 UTC, +1. A player's local day can be one day
    // either side of UTC, so accept [utcDay, utcDay + 2] in 1-based numbering.
    function utcDayIndex() {
      return math.floor((request.time.toMillis() - 1735689600000) / 86400000);
    }

    match /highScores/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'score', 'url', 'timestamp'])
        && validCommon(request.resource.data);
      allow update, delete: if false;
    }

    match /dailyHighScores/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'score', 'url', 'dayNumber', 'timestamp'])
        && validCommon(request.resource.data)
        && request.resource.data.dayNumber is int
        && request.resource.data.dayNumber >= utcDayIndex()
        && request.resource.data.dayNumber <= utcDayIndex() + 2;
      allow update, delete: if false;
    }
  }
}
